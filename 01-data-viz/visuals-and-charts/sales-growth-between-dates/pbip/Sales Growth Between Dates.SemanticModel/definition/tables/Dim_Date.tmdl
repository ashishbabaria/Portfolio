	partition Dim_Date = calculated
		mode: import
		source = ```
				
				VAR _calender = CALENDAR(min('Fact_Combined Sales'[Date_Order]),max('Fact_Combined Sales'[Date_Order]))
				Return 
				ADDCOLUMNS(_calender,
				"Year", YEAR([Date]),
				"Month NO", MONTH([Date]), "Month Name" , Format([Date],"mmm yy"),
				"Week No", WEEKNUM([Date]),
				"Quater", QUARTER(([Date])
				))
				```

	annotation PBI_Id = 3c4a51222a31443ea871515b0897c8fb

