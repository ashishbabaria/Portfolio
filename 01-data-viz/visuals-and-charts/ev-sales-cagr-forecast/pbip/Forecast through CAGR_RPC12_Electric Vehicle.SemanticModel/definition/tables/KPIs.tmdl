	measure 'Datalable Line 4: Detail' =
			
			
			VAR _value = SWITCH(
			                        TRUE(),
			                        [Line 4: EV Sales on Last year of Forecasted sales]<1000, [Line 4: EV Sales on Last year of Forecasted sales],
			                        AND([Line 4: EV Sales on Last year of Forecasted sales]>=1000, [Line 4: EV Sales on Last year of Forecasted sales]<10000), FORMAT([Line 4: EV Sales on Last year of Forecasted sales],"#0,000"),
			                        AND([Line 4: EV Sales on Last year of Forecasted sales]>= 10000,[Line 4: EV Sales on Last year of Forecasted sales]<1000000),FORMAT([Line 4: EV Sales on Last year of Forecasted sales]/1000,"0.00K"),
			                        AND([Line 4: EV Sales on Last year of Forecasted sales]>=1000000,[Line 4: EV Sales on Last year of Forecasted sales]<1000000000),FORMAT([Line 4: EV Sales on Last year of Forecasted sales]/1000000,"0.000M")
			                )
			RETURN _value
		displayFolder: 01: Line Chart
		lineageTag: c734b2d8-9b27-4ab3-aefe-abd0712dbc6e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Datalable Line 3: Value' =
			
			
			VAR _value = SWITCH(
			                        TRUE(),
			                        [Line 3: EV Sales on Last year of Actual sales]<1000, [Line 3: EV Sales on Last year of Actual sales],
			                        AND([Line 3: EV Sales on Last year of Actual sales]>=1000, [Line 3: EV Sales on Last year of Actual sales]<10000), FORMAT([Line 3: EV Sales on Last year of Actual sales],"#0,000"),
			                        AND([Line 3: EV Sales on Last year of Actual sales]>= 10000,[Line 3: EV Sales on Last year of Actual sales]<1000000),FORMAT([Line 3: EV Sales on Last year of Actual sales]/1000,"0.00K"),
			                        AND([Line 3: EV Sales on Last year of Actual sales]>=1000000,[Line 3: EV Sales on Last year of Actual sales]<1000000000),FORMAT([Line 3: EV Sales on Last year of Actual sales]/1000000,"0.000M")
			                )
			RETURN _value
