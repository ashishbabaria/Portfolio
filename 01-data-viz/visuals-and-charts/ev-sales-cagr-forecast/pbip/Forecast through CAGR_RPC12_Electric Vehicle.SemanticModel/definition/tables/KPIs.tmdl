			-- Get First and Last Actual Sales Year
			VAR First_Year = MINX(VALUES('dim_date'[fiscal_year]), [fiscal_year])
			VAR Last_Year = MAXX(VALUES('dim_date'[fiscal_year]), [fiscal_year])
			
