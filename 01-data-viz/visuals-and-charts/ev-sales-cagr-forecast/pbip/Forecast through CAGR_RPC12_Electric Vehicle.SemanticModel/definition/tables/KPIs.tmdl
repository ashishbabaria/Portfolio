table KPIs
	lineageTag: fd0c08ba-b110-4fc7-8800-3cc022569428

	measure 'Total EV Sold States' = sum(electric_vehicle_sales_by_state[electric_vehicles_sold])
		displayFolder: 00: Basic KPIs
		lineageTag: 5bb9c204-2caf-410f-a75f-180e0efec3ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CAGR States EV Sales' =
			
			
			VAR Lastyear = MAX(dim_date[fiscal_year])
			VAR Firstyear = MIN(dim_date[fiscal_year])
			VAR Lastactualsales = CALCULATE([Total EV Sold States], dim_date[fiscal_year] = Lastyear)
			VAR Firstactualsales = CALCULATE([Total EV Sold States], dim_date[fiscal_year] = Firstyear)
			VAR no_of_years = Lastyear- Firstyear
			RETURN
			IF(
			    Firstactualsales > 0,
			    ( (Lastactualsales / Firstactualsales) ^ (1 / no_of_years) ) - 1,
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 00: Basic KPIs
		lineageTag: 185e082a-49ec-43cc-a919-13f70f451440

	measure 'Dynamic CAGR BOTH filter' = ```
			
			
			VAR ActualData =
			    SELECTCOLUMNS(
			        SUMMARIZE(
			            'electric_vehicle_sales_by_state',
			            'dim_date'[fiscal_year], 
			            'electric_vehicle_sales_by_state'[state], 
			            'electric_vehicle_sales_by_state'[vehicle_category], 
			            "Total EV Sold", SUM('electric_vehicle_sales_by_state'[electric_vehicles_sold])
			        ),
			        "fiscal_year", 'dim_date'[fiscal_year],
			        "state", 'electric_vehicle_sales_by_state'[state],
			        "vehicle_category", 'electric_vehicle_sales_by_state'[vehicle_category],
			        "Total EV Sold", [Total EV Sold]
			    )
			
			-- Get First and Last Actual Sales Year
			VAR First_Year = MINX(VALUES('dim_date'[fiscal_year]), [fiscal_year])
			VAR Last_Year = MAXX(VALUES('dim_date'[fiscal_year]), [fiscal_year])
			
			-- Get Sales for First and Last Year
			VAR SalesFirstYear =
			    SUMX(
			        FILTER(
			            ActualData, 
			            [fiscal_year] = First_Year && 
			            [state] IN VALUES('electric_vehicle_sales_by_state'[state]) &&
			            [vehicle_category] IN VALUES('electric_vehicle_sales_by_state'[vehicle_category])
			        ),
			        [Total EV Sold]
			    )
			
			VAR SalesLastYear =
			    SUMX(
			        FILTER(
			            ActualData, 
			            [fiscal_year] = Last_Year && 
			            [state] IN VALUES('electric_vehicle_sales_by_state'[state]) &&
			            [vehicle_category] IN VALUES('electric_vehicle_sales_by_state'[vehicle_category])
			        ),
			        [Total EV Sold]
			    )
			-- Calculate Dynamic CAGR from ActualData
			VAR DynamicCAGR = 
			    IF(
			        SalesFirstYear > 0 && Last_Year > First_Year,
			        ((SalesLastYear / SalesFirstYear) ^ (1 / (Last_Year - First_Year))) - 1,
			        BLANK()
			    )
			
			RETURN DynamicCAGR
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 00: Basic KPIs
		lineageTag: 37294d09-d131-4972-b8ab-f85222f198b6

	measure 'Debug Growth both filters' =
			
			
			VAR EVsold2024 = CALCULATE( sum( 'EV_Sales_Forecast BOTH Filters'[Total EV Sold]), 'EV_Sales_Forecast BOTH Filters'[fiscal_year] = 2024)
			VAR EVsold2025 = CALCULATE( sum( 'EV_Sales_Forecast BOTH Filters'[Total EV Sold]), 'EV_Sales_Forecast BOTH Filters'[fiscal_year] = 2025)
			
			RETURN DIVIDE( EVsold2025,EVsold2024,0) -1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 99: Debug
		lineageTag: bd2be381-a742-4d3f-83b4-6da554114aad

