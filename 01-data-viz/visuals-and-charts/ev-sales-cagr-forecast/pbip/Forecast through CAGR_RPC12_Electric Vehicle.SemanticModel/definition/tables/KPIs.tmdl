		lineageTag: 5a1389a4-d2c5-4f70-b76c-36f4d7e9667a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Datalable Line 2: Value' = ```
			
			
			VAR _currentyear = SELECTEDVALUE(dim_years[fiscal_year])
			VAr _value = SWITCH( TRUE(),
			                    _currentyear= [Last Year of Actual Sales], BLANK(),
			                    _currentyear = [Last Year of forecast], BLANK(), 
			                    [Line 2: Forecast_Sales_Line]
			                    )
			                    
			VAR _fomrmatedvalue = SWITCH(
			                        TRUE(),
			                        _value<1000, _value,
			                        AND(_value>=1000, _value<10000), FORMAT(_value,"#0,000"),
			                        AND(_value>= 10000,_value<1000000),FORMAT(_value/1000,"0.00K"),
			                        AND(_value>=1000000,_value<1000000000),FORMAT(_value/1000000,"0.000M")
			                )
			RETURN _fomrmatedvalue
			```
