	measure 'EV sold wiht forecast' = ```
			
			
			VAR _nofilter = sum( EV_Sales_Forecast[Total EV Sold])
			VAR _bohtfilter = sum( 'EV_Sales_Forecast BOTH Filters'[Total EV Sold])
			VAR _statefilter = sum(EV_Sales_Forecast_Only_State_Filter[Total EV Sold])
			VAR _Vehiclecatfilter = sum( EV_Sales_Forecast_Only_Vehicle_Category_Filter[Total EV Sold])
			
			RETURN SWITCH( TRUE(),
			                ISFILTERED(dim_states[state]) && ISFILTERED( dim_vehicle_Category[Decription]) , _bohtfilter,
			                ISFILTERED(dim_states[state])  && NOT ISFILTERED(dim_vehicle_Category[Decription]) , _statefilter,
			                NOT ISFILTERED(dim_states[state])  && ISFILTERED(dim_vehicle_Category[Decription]) , _Vehiclecatfilter,
			                NOT ISFILTERED(dim_states[state])  && NOT ISFILTERED(dim_vehicle_Category[Decription]), _nofilter
			            )
			
			```
		formatString: 0
		displayFolder: 00: Basic KPIs
		lineageTag: e220ffe7-9fad-4b09-85f3-0f78932fa50f

	measure 'Line 1: Actual_Sales_Line' = ```
			
			VAR LastActualYear = CALCULATE(
			    MAX('dim_date'[fiscal_year]), 
			    ALL('dim_date')
			) 
			VAR TotalEVSold = [EV sold wiht forecast]
			VAR CurrentYear = SELECTEDVALUE(dim_years[fiscal_year])
			RETURN 
			IF(
			    CurrentYear<= LastActualYear, 
			    TotalEVSold,
			    BLANK()
			)
			```
		displayFolder: 01: Line Chart
		lineageTag: bce91350-3668-45b6-b348-80d68b7a2415

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Line 2: Forecast_Sales_Line' = ```
			
			VAR LastActualYear = CALCULATE(
			    MAX('dim_date'[fiscal_year]), 
			    ALL('dim_date')
			) 
			VAR TotalEVSold = [EV sold wiht forecast]
			VAR CurrentYear = SELECTEDVALUE('EV_Sales_Forecast'[fiscal_year])
			RETURN 
			IF(
			    AND (CurrentYear >= LastActualYear, CurrentYear <= [Last Year of forecast]),
			    TotalEVSold,
			    BLANK()
			)
			```
		displayFolder: 01: Line Chart
		lineageTag: 0c4807a0-9abf-4895-8b9e-68aca9183b55

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last Year of forecast' = ```
			
			
			VAR LastActualYear = CALCULATE(
			    MAX('dim_date'[fiscal_year]), 
			    ALL('dim_date')
			)
			VAR _Yers = SELECTEDVALUE('Param 01: No. of Forecast Years'[Forecast years])
			
			VAR ForecastEndYear = LastActualYear + _Yers
			RETURN
			ForecastEndYear
			```
		formatString: 0
		displayFolder: 02: Dynamic Narration text box
		lineageTag: f3e4a514-39f5-4a6d-8a1b-bc1f829c2bb5

	measure 'EV sold with Forccast Filtered with Last year of forecast' =
			
			
			VAR _lastyear = [Last Year of forecast]
			VAR _currentyear = SELECTEDVALUE( dim_years[fiscal_year])
			VAR _totalEVsold =  CALCULATE([EV sold wiht forecast],
			                                FILTER( ADDCOLUMNS( dim_years,"Total Ev Sold", [EV sold wiht forecast]),
			                                    _currentyear <= _lastyear
			                                )
			                            )
			
			
			RETURN _totalEVsold
		displayFolder: 99: Debug
		lineageTag: 5653ed9c-0d9a-498c-a986-fff455898f53

		annotation PBI_FormatHint = {"isGeneralNumber":true}

